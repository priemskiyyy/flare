{
  "name": "flare-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './packages/adapters/*' build",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "lint:typescript": "tsc --noEmit && pnpm -r lint:typescript",
    "lint:eslint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "check": "pnpm build && pnpm lint:typescript && pnpm lint:eslint && pnpm lint:prettier && pnpm test:unit",
    "test:package": "node scripts/verify-packages.mjs",
    "test:examples": "pnpm build && playwright test -c examples/playwright.config.ts",
    "dev:server": "pnpm --filter example-server dev",
    "verify:release": "node scripts/verify-release.mjs",
    "dev:docs": "vitepress dev docs",
    "build:docs": "vitepress build docs",
    "lint:docs": "tsc --noEmit -p docs/tsconfig.json",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:snippets": "node scripts/verify-snippets.mjs",
    "check:release": "pnpm check && pnpm lint:docs && pnpm verify:snippets && pnpm build:docs && pnpm verify:docs && pnpm test:package && pnpm verify:release && pnpm --filter example-expo build && pnpm --filter example-expo build:native"
  },
  "devDependencies": {
    "@bugsnag/js": "8.10.0",
    "@bugsnag/react-native": "8.10.0",
    "@datadog/browser-logs": "7.13.0",
    "@datadog/browser-rum": "7.13.0",
    "@datadog/mobile-react-native": "3.7.0",
    "@eslint/js": "9.39.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@playwright/test": "1.63.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/crashlytics": "26.4.0",
    "@sentry/browser": "10.75.0",
    "@sentry/react-native": "8.27.0",
    "@solidjs/testing-library": "0.8.10",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.20.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.0",
    "jsdom": "27.4.0",
    "posthog-js": "1.434.2",
    "posthog-react-native": "4.75.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "solid-js": "1.9.15",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsdown": "0.22.14",
    "typescript": "5.8.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11",
    "zod": "4.1.12"
  }
}
