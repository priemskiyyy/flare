{
  "name": "@priemskiyyy/flare-solid",
  "version": "0.1.0",
  "description": "Solid bindings for flare: a provider, status primitives that observe without starting anything, and an error boundary that reports what it catches.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/flare.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/flare/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project solid --project solid-ssr"
  },
  "peerDependencies": {
    "@priemskiyyy/flare": ">=0.1.0 <0.2",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@priemskiyyy/flare": "workspace:*"
  },
  "keywords": [
    "solid",
    "solidjs",
    "error-boundary",
    "primitives",
    "error-reporting",
    "typescript",
    "flare"
  ],
  "homepage": "https://priemskiyyy.github.io/flare/"
}
