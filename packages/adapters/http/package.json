{
  "name": "@priemskiyyy/flare-http",
  "version": "0.1.0",
  "description": "HTTP destination for flare: sends each sanitized error report through your own client, with backend acknowledgement as evidence and reports that never cross accounts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/flare.git",
    "directory": "packages/adapters/http"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/flare/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project http"
  },
  "peerDependencies": {
    "@priemskiyyy/flare": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/flare": "workspace:*"
  },
  "keywords": [
    "http",
    "fetch",
    "backend",
    "idempotency",
    "error-reporting",
    "typescript",
    "flare",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/flare/"
}
