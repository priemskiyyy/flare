{
  "name": "@priemskiyyy/flare-posthog-react-native",
  "version": "0.1.0",
  "description": "PostHog error tracking destination for flare on React Native: each report is one $exception event with its own properties and exception steps, sent only while the client identifies the report's user, over the posthog-react-native client you inject.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/flare.git",
    "directory": "packages/adapters/posthog-react-native"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/flare/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../../.. --project posthog-react-native"
  },
  "peerDependencies": {
    "@priemskiyyy/flare": ">=0.1.0 <0.2",
    "posthog-react-native": ">=4.75.0 <5"
  },
  "peerDependenciesMeta": {
    "posthog-react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@priemskiyyy/flare": "workspace:*"
  },
  "keywords": [
    "posthog",
    "error-tracking",
    "error-reporting",
    "react-native",
    "typescript",
    "flare",
    "adapter"
  ],
  "homepage": "https://priemskiyyy.github.io/flare/"
}
