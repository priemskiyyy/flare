{
  "name": "@priemskiyyy/flare-trace",
  "version": "0.1.0",
  "description": "Bridge from Trace to flare: selected analytics events become error-relevant breadcrumbs, with only the properties you map, the time they occurred, and no history replayed.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/flare.git",
    "directory": "packages/trace"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/flare/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project trace"
  },
  "peerDependencies": {
    "@priemskiyyy/flare": ">=0.1.0 <0.2"
  },
  "devDependencies": {
    "@priemskiyyy/flare": "workspace:*"
  },
  "keywords": [
    "trace",
    "analytics",
    "breadcrumbs",
    "error-reporting",
    "typescript",
    "flare",
    "bridge"
  ],
  "homepage": "https://priemskiyyy.github.io/flare/"
}
