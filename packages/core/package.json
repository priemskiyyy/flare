{
  "name": "@priemskiyyy/flare",
  "version": "0.1.0",
  "description": "Provider-independent error reporting runtime: immutable per-report context, account boundaries, redaction, typed routing, fan-out with honest receipts, and a small reporter adapter contract.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priemskiyyy/flare.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/priemskiyyy/flare/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock.d.ts",
      "import": "./dist/mock.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint:typescript": "tsc --noEmit -p .",
    "lint:eslint": "eslint src",
    "test:unit": "vitest run --root ../.. --project core"
  },
  "keywords": [
    "error-reporting",
    "error-tracking",
    "crash-reporting",
    "sentry",
    "bugsnag",
    "crashlytics",
    "redaction",
    "breadcrumbs",
    "typescript",
    "flare",
    "react-native",
    "expo"
  ],
  "homepage": "https://priemskiyyy.github.io/flare/",
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
